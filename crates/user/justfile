# Tests for forma-user that need root and a real system. They run in a VM,
# never on the host; see PLAN.md section 10.3.
#
#   just user::vm-image         build the guest image (once, and when vm/ changes)
#   just user::vm-test [FILTER] run the `#[ignore]`d tests in tests/vm in the guest
#
# The recipes, and the host packages they need, are in crates/common.just. This
# file is loaded from the workspace justfile as the module `user`.

set shell := ["bash", "-euo", "pipefail", "-c"]

# `vm-env` writes `.env`, and just loads it for the next run.
set dotenv-load

# Let this file override the defaults and recipes of common.just.
set allow-duplicate-variables
set allow-duplicate-recipes

import '../common.just'

# The guest built from vm/mkosi.conf.
vm_image_id := "forma-user-test"
