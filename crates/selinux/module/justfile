# Tests for forma-selinux-module that need root and secureblue's SELinux
# policy. They run in a VM, never on the host:
#
#   just selinux::vm-test [FILTER]   run the `#[ignore]`d tests in tests/vm in the guest
#
# They boot the secureblue guest (vm/secureblue) instead of building their
# own: build it with `just secureblue::vm-image`. The recipes are in
# crates/common.just; this file is loaded from the workspace justfile as the
# module `selinux`.

set shell := ["bash", "-euo", "pipefail", "-c"]

# Let this file override the defaults and recipes of common.just.
set allow-duplicate-variables
set allow-duplicate-recipes

import '../../common.just'

# The secureblue guest. Each run still gets its own copy, in vm/run.
vm_image_id := "forma-secureblue-test"
image := env("FORMA_VM_IMAGE", module_directory() / ".." / ".." / ".." / "vm" / "secureblue" / "mkosi.output" / (vm_image_id + ".raw"))

# Each `semodule` and `semanage` call rebuilds the policy, which takes a while
# in a two-CPU guest.
timeout := env("FORMA_VM_TIMEOUT", "1800")

# No image of its own to build
vm-image:
    @echo "selinux uses the secureblue guest; build it with: just secureblue::vm-image"

# No image of its own, so nothing for vm-images to run as root
[private]
vm-image-script:
    @true

# No image of its own, so nothing to record
vm-env:
    @echo "selinux uses the secureblue guest; see: just secureblue::vm-env"
