#!/usr/bin/env bash
# The part of `just vm-test` that needs root: a fresh copy of the image, the VM,
# and handing the result back to the user. Run through run0; see crates/common.just.
#
# usage: launch RUN STAGE IMAGE OWNER TIMEOUT VMSPAWN
set -euo pipefail

run=$1 stage=$2 image=$3 owner=$4 timeout=$5 vmspawn=$6

# The last run's VM left root-owned state (the TPM) in `run`.
rm -rf "$run"
mkdir -p "$run/out"
mv "$stage" "$run/share"
cp --reflink=auto "$image" "$run/disk.raw"
chmod u+w "$run/disk.raw"

vm=(
    "$vmspawn"
    --image="$run/disk.raw"
    --secure-boot=no
    --pass-ssh-key=no
    --ram=2G --cpus=2
    --bind-ro="$run/share":/mnt/forma-test
    --bind="$run/out":/mnt/forma-out
)

# --foreground: without it timeout puts vmspawn in a background process group,
# and the first read from the console stops it (SIGTTIN) and the whole VM with it.
#
# Normally the console is read-only and goes through console-filter, so the
# firmware's boot messages and screen clears never reach the terminal and the
# output joins the rest of the run. With --debug (a `debug` file in the share)
# it is the guest's own console, unfiltered and interactive.
set +e
if [[ -e "$run/share/debug" ]]; then
    timeout --foreground -k 10 "$timeout" "${vm[@]}" --console=native
    status=$?
else
    timeout --foreground -k 10 "$timeout" "${vm[@]}" --console=read-only \
        | "$(dirname "$(readlink -f "$0")")/console-filter"
    status=${PIPESTATUS[0]}
fi
set -e
(( status == 0 )) || echo "the VM stopped with status $status" >&2

chown -R "$owner" "$run"
