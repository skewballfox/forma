# A plain user unit, not a Quadlet. Filters moonshine's D-Bus calls to the
# account's user manager (from corectl's moonshine). Under materia option S it
# goes to /etc/systemd/user/ with a ConditionUser= drop-in
# (docs/proposed_materia_changes.md, F12).
[Unit]
Description=Filtering D-Bus proxy for moonshine (fixture)
Requires=moonshine-bus-volume.service
After=moonshine-bus-volume.service

[Service]
Type=notify
ExecStart=/usr/bin/python3 -I /usr/local/libexec/moonshine-bus-proxy \
    %h/.local/share/containers/storage/volumes/moonshine-bus-vol/_data/bus %t/bus
# No SELinuxContext=: the account runs as user_u, so the proxy's domain comes
# from a type_transition on its entry point (docs/architecture.md 5.9).
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2
